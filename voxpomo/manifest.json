{
  "manifest_version": 3,
  "name": "Pomo – Voice Timer, Stopwatch & Alarm",
  "short_name": "Pomo",
  "version": "1.0.0",
  "description": "Voice-controlled Pomodoro timer, stopwatch and alarm. Say \"set a 25 minute timer\" and a floating digital clock does the rest.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "tts"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pomo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/clock.js", "assets/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "permission.html",
  "commands": {
    "toggle-listening": {
      "suggested_key": { "default": "Alt+Shift+V", "mac": "MacCtrl+Shift+V" },
      "description": "Start or stop voice listening"
    },
    "toggle-floater": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "MacCtrl+Shift+P" },
      "description": "Show or hide the floating clock"
    },
    "start-pause": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S" },
      "description": "Start or pause the timer"
    }
  }
}